{
  "name": "smartbeam",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild --platform android --clean",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "backend": "npm --prefix backend run dev"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.0",
    "@react-native-documents/picker": "^12.0.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~58.0.0",
    "expo-asset": "~58.0.0",
    "expo-build-properties": "~58.0.0",
    "expo-camera": "~58.0.0",
    "expo-keep-awake": "~58.0.0",
    "expo-screen-orientation": "~58.0.0",
    "expo-splash-screen": "~58.0.0",
    "expo-sqlite": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "jszip": "^3.10.1",
    "lucide-react-native": ">=0.475.0 <1",
    "nativewind": "^4.2.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-blob-util": "^0.21.2",
    "react-native-css-interop": "^0.2.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.12.5",
    "react-native-pdf": "^7.0.3",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-video": "^6.10.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.0",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^3.4.14",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/backend/",
      "/android/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|nativewind|react-native-css-interop|lucide-react-native|zustand))"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
